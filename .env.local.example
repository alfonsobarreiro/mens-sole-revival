# ─── Admin dashboard (/admin/assessment-stats) ────────────────────────────────
# Query-param key that unlocks the assessment stats dashboard. Any string;
# treat it like a password. Access the page via:
#   /admin/assessment-stats?key=YOUR_ADMIN_KEY
ADMIN_KEY=change-me-in-vercel

# ─── Google Analytics Data API (for /admin/assessment-stats) ─────────────────
# Powers the assessment funnel dashboard. Setup once:
#   1. GCP: create service account + enable Analytics Data API v1 + download JSON key.
#   2. GA4: Admin → Property → Property access management → add service account
#      email as Viewer on property 534512448.
#   3. base64 -i key.json | pbcopy  → paste as GA_SERVICE_ACCOUNT_JSON_B64
GA_PROPERTY_ID=534512448
GA_SERVICE_ACCOUNT_JSON_B64=

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Get these from: https://sanity.io/manage → your project → Settings → API

# Project ID — visible in your Sanity project URL and dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Dataset — usually "production" for the main dataset
NEXT_PUBLIC_SANITY_DATASET=production

# API version — use today's date or leave as-is (format: YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# ─── Optional: Sanity API token ───────────────────────────────────────────────
# Only needed if you add server-side draft/preview functionality later.
# SANITY_API_READ_TOKEN=your-read-token-here

# ─── Sanity write token (assessment submission capture) ───────────────────────
# Required for /app/actions/assessment-email.ts to persist each assessment
# submission as an assessmentSubmission document in Sanity. Without this,
# submissions still send the user their results email + notify alfonso@,
# but the population-level data does NOT get captured for later analysis.
# Get one at: https://sanity.io/manage → project → API → Tokens → Add API token
#   Role: Editor (or higher). Copy the token immediately — it is only shown once.
# Add to Vercel: Project → Settings → Environment Variables → SANITY_API_WRITE_TOKEN
SANITY_API_WRITE_TOKEN=

# ─── Analytics ────────────────────────────────────────────────────────────────
# GA4 is hardcoded in app/layout.tsx (G-QT90WR1MPD).
# Clarity reads from this env var — get it from clarity.microsoft.com →
# project → Settings → Setup → "Tracking code" → the value after /tag/.
# Leave unset to disable Clarity entirely (no script tag rendered).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Search engine verification ───────────────────────────────────────────────
# Google Search Console — MSR uses the HTML file method
# (public/googlec217f451be35c701.html), so no env var needed.
# Bing Webmaster Tools — easiest path is "Import from Google Search Console"
# in the Bing dashboard; no env var needed for the import flow.
